# Copy this file to .env and fill in real values. Never commit .env.

# Strong random secret for signing JWTs (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# HTTP port for the API (default 3001)
PORT=3001

# ---- Database ----
# Default (local dev): SQLite at DATABASE_PATH.
# DATABASE_PATH=studs.db
# Production: PostgreSQL — no other code changes needed (the money code is
# dialect-independent). Either a single URL…
# DB_TYPE=postgres
# DATABASE_URL=postgres://user:password@host:5432/studs
# …or discrete parts (used when DATABASE_URL is unset):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=studs
# PGPASSWORD=
# PGDATABASE=studs

# Platform commission on the product total, as a decimal (0.15 = 15%).
# Must be between 0 and 1. Settlement fails closed on invalid values.
PLATFORM_COMMISSION_RATE=0.15

# Minutes a PENDING order waits for vendor acceptance before the system
# auto-cancels it and refunds the student in full. Default 30. Set to 0
# to disable the auto-cancel sweeper.
VENDOR_ACCEPT_TIMEOUT_MINUTES=30

# Flat fee (GHS) charged to the sender for a peer-to-peer package delivery.
P2P_DELIVERY_FEE_GHS=5

# ---- SMS fallback (delivery confirmation without QR) ----
# 'log' (default): no gateway — codes are kept in the sms_message outbox and
# printed to the server log. For real SMS, use Arkesel:
# SMS_PROVIDER=arkesel
# ARKESEL_API_KEY=
# ARKESEL_SENDER_ID=STUDS
SMS_PROVIDER=log

# One-time bootstrap for the FIRST administrator account.
# On boot, if no ADMIN user exists in the database, one is created from these.
# Remove them from .env after the first successful boot.
# (Public registration can never create admins; further admins are created
# via POST /auth/admins by an existing administrator.)
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=change-me-to-something-strong

# ---- Payments (Paystack MoMo, test mode) ----
# Which PaymentProvider implementation to use: 'paystack' or 'fake'
# ('fake' is a deterministic in-memory gateway for tests/local dev only).
PAYMENT_PROVIDER=paystack
# Paystack API keys. TEST keys only until the business is ready for live.
# Never commit real keys. Rotate any key that has passed through chat.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Base URL for the Paystack API (default shown; override only if needed).
PAYSTACK_BASE_URL=https://api.paystack.co

# ---- Delivery zones (Go 2) ----
# Distance-band fees (GHS) for bands 0=on campus, 1=near, 2=far.
# Format: "band0,band1,band2". Invalid values fail closed to 5,8,12.
DELIVERY_FEE_BAND_GHS=5,8,12

# ---- Scheduled rider auto-payouts (Go 2) ----
# Daily at 18:00 Africa/Accra: riders with a saved payout destination and
# available balance >= the threshold are paid out automatically.
RIDER_AUTO_PAYOUT_ENABLED=true
RIDER_AUTO_PAYOUT_THRESHOLD_GHS=50

# ---- WhatsApp ordering (Go 2) ----
# 'log' (default): full text-ordering flow runs, replies land in the
# whatsapp_message outbox and the server log. For the real Meta Cloud API:
# WHATSAPP_PROVIDER=cloud
# WHATSAPP_BUSINESS_NUMBER=233XXXXXXXXX   (drives the app's "Order on WhatsApp" buttons)
# WHATSAPP_ACCESS_TOKEN=<token from Meta developer console>
# WHATSAPP_PHONE_NUMBER_ID=<phone number id>
# WHATSAPP_VERIFY_TOKEN=<your own random string, used in the webhook handshake>
# WHATSAPP_APP_SECRET=<app secret, enables X-Hub-Signature-256 verification>
WHATSAPP_PROVIDER=log
